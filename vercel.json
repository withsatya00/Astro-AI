{
  "version": 2,
  "buildCommand": "npm run build:react",
  "outputDirectory": "website/frontend/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://astro-ai-backend-4f0l.onrender.com/api/v1/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://astro-ai-backend-4f0l.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://astro-ai-backend-4f0l.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
