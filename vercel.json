{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://astro-ai-backend-4f0l.onrender.com/api/v1/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://astro-ai-backend-4f0l.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://astro-ai-backend-4f0l.onrender.com/openapi.json"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
