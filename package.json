    "build:css": "npx tailwindcss -i ./website/frontend/src/styles/tailwind-input.css -o ./website/frontend/css/tailwind.css --minify && npx tailwindcss -i ./website/frontend/src/styles/tailwind-input.css -o ./ai/frontend/css/tailwind.css --minify && node scripts/normalize_brand_css.cjs",
    "watch:css": "npx tailwindcss -i ./website/frontend/src/styles/tailwind-input.css -o ./website/frontend/css/tailwind.css --watch",
    "serve:frontend": "node scripts/serve_frontend.js",
    "test:ui": "node scripts/test_frontend_regressions.cjs",
    "test:perf": "node scripts/test_perf_budget.cjs",
    "test:ds": "node scripts/test_design_system.cjs",
    "test:trust": "node scripts/test_trust_content.cjs",
    "test:mobile": "node scripts/test_mobile_nav.cjs",
    "test:steps": "node scripts/test_next_steps.cjs",
    "test:account": "node scripts/test_account_next_steps.cjs",
    "test:seo": "node scripts/test_seo.cjs",
    "test:a11y": "node scripts/test_a11y_basics.cjs",
    "test:cards": "node scripts/test_catalog_cards.cjs",
    "test:detail": "node scripts/test_detail_premium.cjs",
    "test:brand": "node scripts/test_brand_palette.cjs",
    "test:align": "node scripts/test_home_alignment.cjs",
    "test:brandsrc": "node scripts/test_brand_source.cjs",
    "test:buttons": "node scripts/test_buttons_unified.cjs",
    "test:responsive": "node scripts/test_responsive_all.cjs",
    "test:responsive-account": "node scripts/test_responsive_account.cjs",
    "test:seva": "node scripts/test_seva_refresh.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.4.27",
    "linkedom": "^0.18.14",
    "postcss": "^8.5.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17"
  }
}
