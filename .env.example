# AstroAI Agent Environment Configuration

# Application
APP_NAME=AstroAI Agent
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8005
FRONTEND_PORT=3000

# Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Set your Google Gemini API key to enable live AI mode. If left empty, system operates in demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Database Configuration
# Default to SQLite for zero-config local run, or PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://astro_user:astro_password@localhost:5432/astro_ai
DATABASE_URL=sqlite:///./astro_ai.db

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379/0

# Storage Paths
STORAGE_DIR=./storage
DOCUMENTS_DIR=./documents
REPORTS_DIR=./storage/reports
EPHEMERIS_PATH=./ephemeris

# Gau Sewa donations (Razorpay keys are shared with the wallet; leave blank to keep donations closed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SITE_URL=
# Optional receipt email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Advanced workspace: browser web push (HTTPS or localhost)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Per-model token prices in your chosen currency; leave {} to display unavailable cost.
# Format: {"model-id":{"input_per_million":0.0,"output_per_million":0.0}}
AI_MODEL_PRICING_JSON={}
AI_PRICING_CURRENCY=USD
